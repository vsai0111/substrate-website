# systemd unit for the Substrate demo-request API.
#
# Install:
#   sudo cp deploy/substrate-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now substrate-api
#   sudo systemctl status substrate-api
#
# WorkingDirectory points at a symlink that the deploy pipeline flips to the
# new release. systemd re-resolves it on every restart, so a deploy is an
# atomic swap and a rollback is one `ln -sfn` away.

[Unit]
Description=Substrate demo-request API
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=www-data

WorkingDirectory=/var/www/substrate-backend/current

# Credentials live outside the repository.
EnvironmentFile=/etc/substrate/api.env

ExecStart=/usr/bin/node src/index.js

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target