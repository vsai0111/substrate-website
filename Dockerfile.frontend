# Stage 1: Build the Vite React application
FROM node:24-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html vite.config.js ./
COPY public ./public
COPY src ./src

RUN npm run build


# Stage 2: Serve the production build behind nginx.
#
# nginx rather than `serve`, because the SPA and the API have to share one
# origin: nginx reverse-proxies /api/* to the backend service and falls back
# to index.html for client-side routes. `serve -s` cannot proxy — it answers
# /api/* with index.html and a 200, so the form silently does nothing.
FROM nginx:alpine

COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
