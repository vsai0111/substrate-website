# Copy to server/.env and fill in the password. Never commit the real .env.
#
# On the EC2 host these values are provided by /etc/substrate/api.env
# (see deploy/substrate-api.service), not by a file in the repo.

PORT=4000

# MySQL connection.
# The database and the substrate_app user already exist on the server;
# nothing here creates them.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=substrate_app
DB_PASSWORD=
DB_NAME=substrate_db

# Origins allowed to call the API from a browser.
# Production is same-origin through nginx, so this only matters when running
# the Vite dev server against a remote or local API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
