{
  "name": "substrate-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Substrate - React + Vite studio site with a Book a Demo page backed by Express and MySQL.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "dev:api": "npm run dev --prefix server",
    "start:api": "npm start --prefix server",
    "migrate": "npm run migrate --prefix server",
    "install:all": "npm install && npm install --prefix server"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "vite": "^8.2.2"
  }
}
